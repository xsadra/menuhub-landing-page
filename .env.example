# ==============================================================================
# MENUHUB PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and update with your production credentials
# ==============================================================================

# Server Port
PORT=8080

# Admin Alert Destination (Where newsletter & purchase notifications are delivered)
ADMIN_EMAIL=info@menuhub.app

# Sender Email Display
FROM_EMAIL="MenuHub Alerts <notifications@menuhub.app>"

# ------------------------------------------------------------------------------
# OPTION 1: Resend Cloud Email Provider (Recommended for Instant Setup)
# Get your free API key at https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here

# ------------------------------------------------------------------------------
# OPTION 2: Standard SMTP / Nodemailer (Gmail, SendGrid, Amazon SES, Custom)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
